# 1. En navegador web / desarrollo (Vite redirige /api al backend de BellaStyle)
VITE_API_BASE_URL=/api

# 2. En celular físico Android / iOS (Capacitor)
# Puedes poner la IP local de tu PC (ej: http://192.168.1.15:3000/api) o tu URL de Vercel:
VITE_NATIVE_API_BASE_URL=https://proyecto-aula-bella-style-manager.vercel.app/api

# 3. Destino del proxy de Vite en desarrollo local (tu mismo backend Node/Express de BellaStyle en el puerto 3000)
API_PROXY_TARGET=http://localhost:3000
