{
  "name": "bellastyle-backend",
  "version": "2.0.0",
  "description": "BellaStyle Manager - servidor Node.js + Express + MySQL",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "css": "tailwindcss -c ../frontend/tailwind.config.js -i ../frontend/src/estilos.css -o ../frontend/css/estilos.css --minify",
