{
  "version": 2,
  "headers": [
    {
      "source": "/descargas/BellaStyle-Mobile.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"BellaStyle-Mobile.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://proyecto-aula-bellastyle-manager.onrender.com/api/$1"
    },
    {
      "source": "/descargar-apk",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
